{
  "name": "steam-tracker",
  "version": "1.0.0",
  "description": "Steam Tracker — Achievement Overlay",
  "author": "Fermin Marques",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win --x64",
    "dist:dir": "electron-vite build && electron-builder --win --x64 --dir"
  },
  "build": {
    "appId": "com.achivio.overlay",
    "productName": "Achivio",
    "files": ["out/**/*", "package.json"],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Achivio"
    },
    "portable": {
      "artifactName": "Achivio-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "axios": "^1.7.9",
    "pinia": "^2.2.6",
    "vue": "^3.5.12"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@vitejs/plugin-vue": "^5.1.4",
    "electron": "^34.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vue-tsc": "^2.1.10"
  }
}
